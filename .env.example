# Copy this file to .env and fill in your Supabase project's values.
# Find both at: Supabase Dashboard -> your project -> Settings -> API.
#
# VITE_SUPABASE_ANON_KEY is safe to expose in the browser bundle — it
# has no access on its own. All access control is enforced by the
# Row-Level Security policies in supabase/schema.sql. Never put the
# service_role key in a VITE_ variable; that key must stay server-side
# only (e.g. in whatever tool you use internally to create bookings).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Analytics 4 — Measurement ID from GA4: Admin -> Data Streams ->
# your web stream -> Measurement ID (starts with "G-"). Leave unset to
# keep analytics disabled (no script loads, nothing is tracked).
# Note: GA4 sets cookies — if you have EU/UK visitors, a cookie-consent
# banner is likely required before this loads. Not included here.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
